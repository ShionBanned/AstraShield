{
    "manifest_version":  3,
    "name":  "Astra AdShield (Custom MV3)",
    "version":  "1.0.0",
    "description":  "Unified, zero-whitelist AdBlock built from deep reverse engineering of eyeo/ABP engines.",
    "permissions":  [
                        "declarativeNetRequest",
                        "declarativeNetRequestFeedback",
                        "storage",
                        "scripting",
                        "tabs",
                        "activeTab"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "declarative_net_request":  {
                                    "rule_resources":  [
                                                           {
                                                               "id":  "network_block_rules",
                                                               "enabled":  true,
                                                               "path":  "rules/network_rules.json"
                                                           },
                                                           {
                                                               "id":  "ruleset_easylist",
                                                               "enabled":  true,
                                                               "path":  "rules/easylist.json"
                                                           }
                                                       ]
                                },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "scripts/scriptlets.js"
                                       ],
                                "run_at":  "document_start",
                                "world":  "MAIN"
                            },
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "scripts/content.js"
                                       ],
                                "css":  [
                                            "styles/cosmetic.css"
                                        ],
                                "run_at":  "document_start"
                            }
                        ],
    "action":  {
                   "default_popup":  "popup/popup.html",
                   "default_title":  "AstraShield Ultra",
                   "default_icon":  {
                                        "16":  "icons/icon-16.png",
                                        "32":  "icons/icon-32.png",
                                        "48":  "icons/icon-48.png",
                                        "128":  "icons/icon-128.png"
                                    }
               },
    "background":  {
                       "service_worker":  "scripts/background.js"
                   },
    "icons":  {
                  "16":  "icons/icon-16.png",
                  "32":  "icons/icon-32.png",
                  "48":  "icons/icon-48.png",
                  "128":  "icons/icon-128.png"
              }
}